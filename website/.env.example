# Website service — Firestore backend. Copy to .env for local dev (never commit .env).

# Paste the FULL service-account JSON on one line (Firebase console →
# Project settings → Service accounts → Generate new private key).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}

# PORT is set automatically by Railway; only needed locally for a custom port.
PORT=3000

# --- Local testing against the Firestore emulator (instead of real Firebase) ---
# Leave FIREBASE_SERVICE_ACCOUNT unset when using the emulator.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GCLOUD_PROJECT=demo-tycf
