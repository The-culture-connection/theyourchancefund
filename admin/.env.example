# Admin service — Firestore backend. Copy to .env for local dev (never commit .env).

# Same Firebase project/service account as the website service.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}

# Committee login password (required).
ADMIN_PASSWORD=change-me-to-a-strong-password
# Long random string so login sessions survive restarts.
SESSION_SECRET=replace-with-a-long-random-string
# "production" enables secure cookies (set on Railway).
NODE_ENV=development
PORT=3001

# --- Local testing against the Firestore emulator (instead of real Firebase) ---
# Leave FIREBASE_SERVICE_ACCOUNT unset when using the emulator.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GCLOUD_PROJECT=demo-tycf
