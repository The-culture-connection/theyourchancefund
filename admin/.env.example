# Admin service — copy to .env for local development (do NOT commit .env)
# Must point at the SAME database as the website service.
DATABASE_URL=postgres://user:password@localhost:5432/tycf
PGSSL=disable

# Committee login password (required).
ADMIN_PASSWORD=change-me-to-a-strong-password
# Long random string so login sessions survive restarts.
SESSION_SECRET=replace-with-a-long-random-string
# "production" enables secure cookies (set on Railway).
NODE_ENV=development
PORT=3001
